{
  "trailingSlash": false,
  "routes": [
    { "src": "/api/(.*)", "dest": "https://backend-production-25cad.up.railway.app/api/$1" },
    { "src": "/static/(.*)", "dest": "/$1" },
    { "src": "/global", "dest": "/index.html" },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/projekty", "dest": "/projekty.html" },
    { "src": "/projekt", "dest": "/projekt.html" },
    { "src": "/plan", "dest": "/plan.html" },
    { "src": "/", "dest": "/login.html" },
    { "handle": "filesystem" }
  ]
}
